---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import TopicChip from '../components/TopicChip.astro';
import { articles, LINKS } from '../content';
import { ext } from '../components/ext';

const featured = articles.find((a) => a.featured);
const topics = [...new Set(articles.map((a) => a.topic))];
const count = (t: string) => articles.filter((a) => a.topic === t).length;
---
<Base title="Writing" description="Articles by Ajay Kumar on Flutter, architecture, DevOps, Firebase and engineering, published on Medium." current="Writing">
  <header class="container page-head">
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">Notes from building things: how Flutter works under the hood, setting up projects that stay easy to change, and the habits that make teams better. Every post opens on Medium.</p>
  </header>

  {featured && (
    <section class="container section" aria-labelledby="featured-title">
      <h2 class="section-title" id="featured-title">Featured</h2>
      <div class="featured">
        <ArticleCard href={featured.href} title={featured.title} topic={featured.topic} date={featured.date} />
      </div>
    </section>
  )}

  <div class="container section writing-layout">
    <section aria-labelledby="all-title">
      <h2 class="section-title" id="all-title">All articles</h2>
      <div class="filters" role="group" aria-labelledby="filter-label" data-filters hidden>
        <span id="filter-label" class="cs-meta">Filter by topic</span>
        <TopicChip value="" selected>All</TopicChip>
        {topics.map((t) => <TopicChip value={t}>{t}</TopicChip>)}
      </div>
      <p class="visually-hidden" aria-live="polite" data-status></p>
      <ul class="articles">
        {articles.map((a) => <li data-topic={a.topic}><ArticleCard href={a.href} title={a.title} topic={a.topic} date={a.date} /></li>)}
      </ul>
    </section>

    <aside class="rail" aria-labelledby="rail-title">
      <h2 class="rail-title" id="rail-title">Topics</h2>
      <ul class="topic-counts">
        {topics.map((t) => <li><span>{t}</span><span class="cs-tag">{count(t)}</span></li>)}
      </ul>
      <a class="cs-link" href={LINKS.medium} {...ext(LINKS.medium)}>Follow on Medium</a>
    </aside>
  </div>
</Base>

<script is:inline>
  (function () {
    var group = document.querySelector('[data-filters]');
    if (!group) return;
    var chips = group.querySelectorAll('.cs-chip');
    var items = document.querySelectorAll('.articles > li');
    var status = document.querySelector('[data-status]');
    group.hidden = false;
    group.addEventListener('click', function (e) {
      var chip = e.target.closest('.cs-chip');
      if (!chip) return;
      var value = chip.dataset.value, shown = 0;
      chips.forEach(function (c) {
        var on = c === chip;
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
        c.classList.toggle('is-selected', on);
      });
      items.forEach(function (li) {
        var match = !value || li.dataset.topic === value;
        li.hidden = !match;
        if (match) shown++;
      });
      status.textContent = 'Showing ' + shown + (shown === 1 ? ' article' : ' articles') + (value ? ' about ' + value : '');
    });
  })();
</script>

<style>
  .featured { margin-top: var(--space-4); }
  .featured :global(.cs-card) { border-radius: var(--radius-card-lg); padding: var(--space-4); }
  .featured :global(.cs-card-title) { font-size: 30px; }
  .writing-layout { display: grid; grid-template-columns: minmax(0, 1fr) var(--rail-width); gap: var(--space-8); align-items: start; }
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); margin: var(--space-4) 0 0; }
  .filters[hidden] { display: none; }
  .filters .cs-meta { margin-right: var(--space-1); }
  .articles { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: var(--space-2); max-width: var(--reading-column); }
  .articles > li[hidden] { display: none; }
  .rail { display: grid; gap: var(--space-2); padding: var(--space-3); background: var(--surface-panel); border: 1px solid var(--border); border-radius: var(--radius-card); }
  .rail-title { margin: 0; font: 700 20px/1.3 var(--font-sans); }
  .topic-counts { list-style: none; margin: 0; padding: 0; display: grid; }
  .topic-counts li { display: flex; justify-content: space-between; padding: var(--space-1) 0; border-bottom: 1px solid var(--border); }
  @media (max-width: 1099px) {
    .writing-layout { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    .rail { max-width: var(--reading-column); }
  }
  @media (max-width: 767px) {
    .featured :global(.cs-card) { padding: var(--space-3); }
    .featured :global(.cs-card-title) { font-size: 24px; }
  }
</style>
