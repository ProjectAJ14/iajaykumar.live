---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Arrow from '../components/Arrow.astro';
import { LINKS, speakingMailto } from '../content';
import { ext } from '../components/ext';

const channels = [
  { name: 'Email', detail: LINKS.email, label: 'Send me an email', href: `mailto:${LINKS.email}` },
  { name: 'LinkedIn', label: 'Connect on LinkedIn', href: LINKS.linkedin },
  { name: 'GitHub', label: 'Follow on GitHub', href: LINKS.github },
  { name: 'YouTube', label: 'Watch on YouTube', href: LINKS.youtube },
  { name: 'Medium', label: 'Read on Medium', href: LINKS.medium },
  { name: 'Stack Overflow', label: 'See my Stack Overflow profile', href: LINKS.stackoverflow },
];
---
<Base title="Contact" description="How to reach Ajay Kumar: email, LinkedIn, GitHub, YouTube, Medium and Stack Overflow, plus speaking invitations." current="Contact">
  <header class="container page-head">
    <h1 class="page-title">Contact</h1>
    <p class="page-lede">Email is the quickest way to reach me. You can also find me on these channels.</p>
  </header>

  <section class="container section" aria-labelledby="invite-title">
    <div class="cs-card invite">
      <h2 class="section-title" id="invite-title">Planning an event?</h2>
      <p class="cs-muted">I give talks and workshops on full-stack product building, Flutter and mobile architecture, and developer tools. Send the date, audience and format, and I will reply by email.</p>
      <div><Button href={speakingMailto}>Invite me to speak</Button></div>
    </div>
  </section>

  <section class="container section" aria-labelledby="channels-title">
    <div class="section-head"><h2 class="section-title" id="channels-title">Channels</h2></div>
    <ul class="grid-3 channels">
      {channels.map((c) => (
        <li class="cs-card">
          <h3 class="cs-card-title">{c.name}</h3>
          {c.detail && <p class="cs-muted channel-detail">{c.detail}</p>}
          <a class="cs-link" href={c.href} {...ext(c.href)}>{c.label}<Arrow /></a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .invite { gap: var(--space-2); padding: var(--space-4); max-width: var(--reading-column); }
  .channels { list-style: none; margin: 0; padding: 0; }
  .channel-detail { overflow-wrap: anywhere; }
</style>
