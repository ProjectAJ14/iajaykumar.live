---
// Both icons render; CSS shows the one for the current theme. Click handling lives in Base.astro.
---
<button type="button" class="cs-theme" data-theme-toggle aria-label="Switch theme">
  <svg class="cs-ico icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
  <svg class="cs-ico icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
</button>
<style is:global>
  html[data-theme="light"] .cs-theme .icon-moon, html:not([data-theme="light"]) .cs-theme .icon-sun { display: none; }
</style>
